---
/**
 * The signature device: an oversized gradient numeral with its caption and
 * (required) source attribution. Used in the Home hero, Challenge, and Scale.
 */
import type { Stat } from '../data/stats';
export interface Props {
  stat: Stat;
  small?: boolean;
}
const { stat, small = false } = Astro.props;
---

<div class="stat">
  <p class:list={['stat-num', { 'stat-num--sm': small }]}>{stat.value}</p>
  <p class="stat__label">{stat.label}</p>
  <p class="source"><span class="source__from">Source:</span> <cite>{stat.source}</cite></p>
</div>

<style>
  .stat__label {
    margin-top: 0.75rem;
    color: var(--slate-70);
    max-width: 32ch;
  }
  .source__from {
    color: var(--slate-50);
  }
</style>
