---
import { fundingPrograms } from '../data/funding';
---

<div class="funding">
  <table class="funding__table">
    <thead>
      <tr>
        <th scope="col">Program</th>
        <th scope="col">Amount</th>
        <th scope="col">What it funds for employers</th>
      </tr>
    </thead>
    <tbody>
      {
        fundingPrograms.map((p) => (
          <tr>
            <th scope="row" class="funding__program">
              {p.href ? (
                <a href={p.href} rel="noopener" target="_blank">
                  {p.program}
                </a>
              ) : (
                <span>{p.program}</span>
              )}
              <span class="funding__agencies">{p.agencies}</span>
            </th>
            <td class="funding__amount">{p.amount}</td>
            <td class="funding__funds">{p.funds}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .funding {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .funding__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    text-align: left;
  }

  .funding__table thead th {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--teal-deep);
    font-weight: 600;
    padding: 0 1rem 0.85rem;
    border-bottom: 2px solid var(--tint-deep);
    vertical-align: bottom;
  }

  .funding__table tbody tr {
    border-bottom: 1px solid var(--line);
  }

  .funding__table td,
  .funding__table tbody th {
    padding: 1.4rem 1rem;
    vertical-align: top;
  }

  .funding__program {
    font-weight: 700;
    color: var(--slate);
    max-width: 20rem;
  }

  .funding__program a {
    color: var(--slate);
    text-decoration: none;
    border-bottom: 1px solid var(--seafoam);
    padding-bottom: 1px;
  }

  .funding__program a:hover {
    color: var(--teal-deep);
    border-bottom-color: var(--teal);
  }

  .funding__agencies {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--slate-50);
    letter-spacing: 0.02em;
  }

  .funding__amount {
    font-weight: 700;
    color: var(--teal-deep);
    white-space: nowrap;
  }

  .funding__funds {
    color: var(--slate-70);
    font-size: 0.95rem;
    max-width: 34rem;
  }
</style>
