---
import Wordmark from './Wordmark.astro';
import { SITE, NAV } from '../data/site';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark />
      <p class="site-footer__tag">{SITE.tagline}</p>
      <p class="site-footer__mission">{SITE.mission}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/express-interest">Express Interest</a></li>
      </ul>
    </nav>

    <div class="site-footer__contact">
      <p class="site-footer__label">Contact</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>© {SITE.year} {SITE.legalEntity}. All rights reserved.</p>
    <a href="/privacy">Privacy</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--tint);
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem) 1.5rem;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .site-footer__brand :global(.wordmark) {
    font-size: 1.2rem;
  }

  .site-footer__tag {
    margin-top: 0.75rem;
    color: var(--slate);
    font-weight: 600;
  }

  .site-footer__mission {
    margin-top: 0.25rem;
    color: var(--slate-50);
    font-size: 0.95rem;
    max-width: 34ch;
  }

  .site-footer__nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }

  .site-footer__nav a,
  .site-footer__contact a {
    color: var(--slate-70);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-footer__nav a:hover,
  .site-footer__contact a:hover {
    color: var(--teal-deep);
  }

  .site-footer__label {
    color: var(--slate);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .site-footer__contact a {
    font-weight: 500;
    color: var(--teal-deep);
  }


  .site-footer__legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--slate-50);
    font-size: 0.85rem;
  }

  .site-footer__legal a {
    color: var(--slate-50);
    text-decoration: none;
  }

  .site-footer__legal a:hover {
    color: var(--teal-deep);
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 460px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
