---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import PillarCard from '../components/PillarCard.astro';
import { SITE } from '../data/site';
import { pillars } from '../data/pillars';
import { gains, costs } from '../data/stats';

const phases = [
  {
    label: 'Phase 1',
    title: 'Pilot cohort',
    detail: 'A founding group of organizations upskilled against the four pillars, at no commercial cost.',
  },
  {
    label: 'Phase 2',
    title: 'Documented outcomes',
    detail: 'Measured productivity, governance, and retention gains, published as impact benchmarks.',
  },
  {
    label: 'Phase 3',
    title: 'National scale',
    detail: 'Proven frameworks extended toward 100 million AI-ready workers by 2030.',
  },
];
---

<Base
  title="The Initiative"
  description="Project 100 Million: 100 million AI-ready workers by 2030. AI readiness is demonstrated capability, not tool ownership. Four delivery pillars mapped to business outcomes, and a phased path from pilot to national scale."
  path="/initiative"
>
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="The Initiative"
        heading="100 million AI-ready workers by 2030"
        lead="AI readiness isn't owning tools. It's demonstrated capability to apply AI effectively, ethically, and productively in role-specific contexts. Four delivery pillars map directly to business outcomes."
      />
    </div>
  </section>

  {/* Pillars */}
  <section class="section section--tint" aria-labelledby="pillars-heading">
    <div class="container">
      <h2 id="pillars-heading" class="visually-hidden">The four delivery pillars</h2>
      <div class="grid grid--4">
        {pillars.map((pillar, i) => <PillarCard pillar={pillar} index={i} />)}
      </div>
    </div>
  </section>

  {/* Business case */}
  <section class="section" aria-labelledby="case-heading">
    <div class="container">
      <SectionHead
        eyebrow="The business case"
        heading="What the prepared gain and what waiting costs"
        id="case-heading"
      />
      <div class="grid grid--2 case__grid">
        <div class="case__col case__col--gain">
          <h3 class="case__col-title">AI-ready organizations gain</h3>
          <ul class="case__list">
            {gains.map((g) => <li>{g}</li>)}
          </ul>
        </div>
        <div class="case__col case__col--cost">
          <h3 class="case__col-title">Organizations that wait face</h3>
          <ul class="case__list case__list--cost">
            {
              costs.map((c) => (
                <li>
                  <strong>{c.heading}:</strong> {c.detail}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="case__note">
        Retraining later costs more than proactive upskilling now, and replacement at scale costs
        most of all. Only ~15% of AI productivity gains come from capital investment; the vast
        majority come from process, innovation, and people.
        <span class="source"><cite>Source: NBER survey of 750 CFOs</cite></span>
      </p>
    </div>
  </section>

  {/* Phased model */}
  <section class="section section--tint" aria-labelledby="phases-heading">
    <div class="container">
      <SectionHead
        eyebrow="The path to scale"
        heading="Prove it with a pilot, then scale what works"
        id="phases-heading"
      />
      <ol class="phases">
        {
          phases.map((p) => (
            <li class="phase card">
              <span class="phase__label">{p.label}</span>
              <h3 class="phase__title">{p.title}</h3>
              <p class="phase__detail">{p.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* CTA */}
  <section class="section closing">
    <div class="container container--narrow closing__inner">
      <h2 class="closing__title">Join the founding pilot cohort.</h2>
      <p class="closing__lead">
        Early interest is open for a select few. Expressing interest is one short reply. No
        commitment, no obligation, no cost.
      </p>
      <a class="btn btn--primary" href="/express-interest">Express Interest</a>
    </div>
  </section>
</Base>

<style>
  .case__grid {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
  }

  .case__col {
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-lg);
  }
  .case__col--gain {
    background: linear-gradient(160deg, var(--tint-deep), var(--tint));
  }
  .case__col--cost {
    background: var(--white);
    border: 1px solid var(--line);
  }

  .case__col-title {
    font-size: var(--fs-h3);
    margin-bottom: 1.25rem;
  }
  .case__col--gain .case__col-title {
    color: var(--teal-deep);
  }

  .case__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .case__list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--slate-70);
    font-size: 0.98rem;
  }
  .case__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
  }
  .case__list--cost li::before {
    background: var(--ice);
  }

  .case__note {
    margin-top: clamp(2rem, 1rem + 2vw, 2.75rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    color: var(--slate);
    font-size: var(--fs-lead);
    max-width: 70ch;
  }
  .case__note .source {
    margin-top: 0.75rem;
  }

  .phases {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
  }
  .phase {
    counter-increment: none;
  }
  .phase__label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--teal-deep);
  }
  .phase__title {
    font-size: var(--fs-h3);
    margin-top: 0.5rem;
  }
  .phase__detail {
    margin-top: 0.75rem;
    color: var(--slate-70);
    font-size: 0.98rem;
  }

  @media (max-width: 760px) {
    .phases {
      grid-template-columns: 1fr;
    }
  }

  .closing {
    text-align: center;
  }
  .closing__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .closing__title {
    font-size: var(--fs-h2);
  }
  .closing__lead {
    margin-block: 1rem 2rem;
    font-size: var(--fs-lead);
    color: var(--slate-70);
    max-width: 46ch;
  }
</style>
