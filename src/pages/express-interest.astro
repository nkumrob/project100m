---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { organizationTypes } from '../data/pillars';
---

<Base
  title="Express Interest"
  description="Express interest in Project 100 Million in one short reply. Four fields, no commitment, no obligation, no cost."
  path="/express-interest"
  hideCta={true}
>
  <section class="section eoi">
    <div class="container eoi__grid">
      {/* Left rail: framing + reassurance */}
      <aside class="eoi__rail">
        <p class="eyebrow">Express interest</p>
        <h1 class="eoi__title">One short reply opens the conversation.</h1>
        <p class="eoi__lead">
          Four fields. That’s the whole ask. Selected organizations join the founding pilot cohort
          at no commercial cost.
        </p>
        <ul class="eoi__assure">
          <li><strong>Not a contract.</strong> No commitment, no obligation, no cost.</li>
          <li>Your details are used only to follow up on your interest.</li>
        </ul>
        <p class="eoi__alt">
          Prefer email? Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </aside>

      {/* Form */}
      <div class="eoi__formwrap card">
        {/*
          PLACEHOLDER: submission backend is intentionally not wired yet.
          When ready, set action to the serverless endpoint (e.g. "/api/express-interest"),
          method POST, and remove data-preview so the on-page script stops intercepting.
          All fields, names, and the honeypot are already in place for that handler.
        */}
        <form
          id="eoi-form"
          class="form"
          method="POST"
          action="/api/express-interest"
          data-preview="true"
          novalidate
        >
          {/* Honeypot: hidden from humans, tempting to bots. Backend rejects if filled. */}
          <div class="hp" aria-hidden="true">
            <label for="company-website">Company website (leave blank)</label>
            <input id="company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="field">
            <label for="org-name">Organization name <span class="req">*</span></label>
            <input id="org-name" name="organization_name" type="text" required autocomplete="organization" />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="contact-name">Contact name <span class="req">*</span></label>
              <input id="contact-name" name="contact_name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="contact-role">Role <span class="req">*</span></label>
              <input id="contact-role" name="contact_role" type="text" required autocomplete="organization-title" />
            </div>
          </div>

          <div class="field">
            <label for="contact-email">Work email <span class="req">*</span></label>
            <input id="contact-email" name="contact_email" type="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="org-type">Organization type <span class="req">*</span></label>
            <select id="org-type" name="organization_type" required>
              <option value="" disabled selected>Select one…</option>
              {organizationTypes.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="challenges">
              2–3 workforce or AI-readiness challenges you’re facing <span class="req">*</span>
            </label>
            <textarea id="challenges" name="challenges" rows="5" required
              placeholder="A few sentences is plenty. What’s hardest about getting your workforce AI-ready?"></textarea>
          </div>

          <div class="form__foot">
            <button type="submit" class="btn btn--primary form__submit">Express Interest</button>
            <p class="form__reassure">
              Not a contract. No commitment, no obligation, no cost.
            </p>
          </div>

          {/* Preview / error notices (revealed by the script) */}
          <p id="form-preview-note" class="form__notice form__notice--preview" hidden role="status">
            <strong>Preview mode.</strong> Submissions aren’t connected yet. When wired, this form
            confirms on-screen and emails you a copy.
            <a href="/thank-you">Preview the confirmation screen →</a>
          </p>
          <p id="form-error" class="form__notice form__notice--error" hidden role="alert"></p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  // Progressive enhancement: inline validation + intercept while backend is unwired.
  const form = document.getElementById('eoi-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('form-error');
  const previewEl = document.getElementById('form-preview-note');

  if (form) {
    form.addEventListener('submit', (e) => {
      if (errorEl) errorEl.hidden = true;

      if (!form.checkValidity()) {
        e.preventDefault();
        const firstInvalid = form.querySelector(':invalid') as HTMLElement | null;
        if (firstInvalid) {
          firstInvalid.focus();
          if (errorEl) {
            errorEl.textContent = 'Please complete the required fields before submitting.';
            errorEl.hidden = false;
          }
        }
        return;
      }

      // Backend deferred, show preview notice instead of a real POST.
      if (form.dataset.preview === 'true') {
        e.preventDefault();
        if (previewEl) {
          previewEl.hidden = false;
          previewEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });
  }
</script>

<style>
  .eoi__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }

  .eoi__rail {
    position: sticky;
    top: 92px;
  }

  .eoi__title {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem);
    margin-top: 1rem;
  }
  .eoi__lead {
    margin-top: 1.1rem;
    font-size: var(--fs-lead);
    color: var(--slate-70);
  }
  .eoi__assure {
    list-style: none;
    padding: 0;
    margin-top: 1.75rem;
    display: grid;
    gap: 0.85rem;
  }
  .eoi__assure li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--slate-70);
    font-size: 0.98rem;
  }
  .eoi__assure li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--teal);
    font-weight: 700;
  }
  .eoi__alt {
    margin-top: 1.75rem;
    font-size: 0.95rem;
    color: var(--slate-50);
  }

  /* Form */
  .form {
    display: grid;
    gap: 1.4rem;
  }
  .field {
    display: grid;
    gap: 0.45rem;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }
  .field label {
    font-weight: 600;
    color: var(--slate);
    font-size: 0.95rem;
  }
  .req {
    color: var(--teal-deep);
  }
  input,
  select,
  textarea {
    font: inherit;
    color: var(--slate);
    background: #fff;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 0.8rem 0.9rem;
    width: 100%;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--seafoam);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(46, 139, 127, 0.15);
  }
  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  /* Honeypot, visually and semantically removed for humans */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__foot {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .form__submit {
    flex-shrink: 0;
  }
  .form__reassure {
    font-size: 0.85rem;
    color: var(--slate-50);
    max-width: 30ch;
  }

  .form__notice {
    padding: 1rem 1.15rem;
    border-radius: 10px;
    font-size: 0.92rem;
  }
  .form__notice--preview {
    background: var(--tint-deep);
    color: var(--slate-70);
  }
  .form__notice--preview a {
    display: inline-block;
    margin-top: 0.35rem;
    font-weight: 600;
  }
  .form__notice--error {
    background: #fdecec;
    color: #a12a2a;
  }

  @media (max-width: 860px) {
    .eoi__grid {
      grid-template-columns: 1fr;
    }
    .eoi__rail {
      position: static;
    }
  }
  @media (max-width: 480px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
