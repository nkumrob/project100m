---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import StatBig from '../components/StatBig.astro';
import { SITE } from '../data/site';
import { contradictions, structuralGaps, scaleStats } from '../data/stats';
---

<Base
  title="The Challenge"
  description="AI adoption is accelerating while workforce readiness moves the other way. The research behind Project 100 Million: the readiness gap, five structural failures, and the scale of transformation ahead, every figure sourced."
  path="/challenge"
>
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="The Challenge"
        heading="AI adoption is accelerating. Readiness is moving the other way."
        lead="Organizations are deploying AI at record pace while becoming less confident their people can use it well. This is not a slow-building concern. It is a structural failure happening in real time, with a hard 2030 deadline."
      />
    </div>
  </section>

  {/* The contradiction */}
  <section class="section section--tint" aria-labelledby="contradiction-heading">
    <div class="container">
      <p class="eyebrow">The contradiction, in the leaders' own numbers</p>
      <h2 id="contradiction-heading" class="block-title">
        Every leading indicator points the wrong way.
      </h2>
      <div class="grid grid--2 contradiction__grid">
        {contradictions.map((stat) => <StatBig stat={stat} small />)}
      </div>
    </div>
  </section>

  {/* Five structural gaps */}
  <section class="section" aria-labelledby="gaps-heading">
    <div class="container">
      <SectionHead
        eyebrow="Five structural gaps"
        heading="The failures compound each other"
        id="gaps-heading"
      />
      <ol class="gaps">
        {
          structuralGaps.map((gap) => (
            <li class="gap">
              <span class="gap__name">{gap.name}</span>
              <span class="gap__figure stat-num stat-num--sm">{gap.figure}</span>
              <span class="gap__detail">{gap.detail}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Scale */}
  <section class="section section--tint" aria-labelledby="scale-heading">
    <div class="container">
      <SectionHead
        eyebrow="The scale of what's coming"
        heading="A net-positive transformation, but only for those who prepared in advance"
        lead="Goldman Sachs estimates 300 million jobs globally are exposed to automation over the next decade, with ~25% of US work tasks potentially automated. 86% of employers expect AI to transform their business by 2030."
        id="scale-heading"
      />
      <div class="grid grid--3 scale__grid">
        {scaleStats.map((stat) => <StatBig stat={stat} small />)}
      </div>
    </div>
  </section>

  {/* Closing CTA */}
  <section class="section brief-cta">
    <div class="container container--narrow brief-cta__inner">
      <h2 class="brief-cta__title">This is the gap Project 100 Million closes.</h2>
      <p class="brief-cta__lead">
        See how the initiative turns this research into role-specific readiness, and how the federal
        funding aligns to your workforce.
      </p>
      <div class="brief-cta__actions">
        <a class="btn btn--primary" href="/express-interest">Express Interest</a>
        <a class="btn btn--ghost" href="/initiative">How the initiative works</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .block-title {
    font-size: var(--fs-h2);
    margin-top: 0.9rem;
    max-width: 22ch;
  }

  .contradiction__grid,
  .scale__grid {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
  }

  .gaps {
    list-style: none;
    counter-reset: gap;
    padding: 0;
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .gap {
    display: grid;
    grid-template-columns: 12rem 8rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .gap__name {
    font-weight: 700;
    color: var(--slate);
    font-size: 1.05rem;
  }

  .gap__figure {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
  }

  .gap__detail {
    color: var(--slate-70);
    align-self: center;
  }

  @media (max-width: 760px) {
    .gap {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding-block: 1.5rem;
    }
    .gap__detail {
      margin-top: 0.4rem;
    }
  }

  .brief-cta {
    text-align: center;
  }
  .brief-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brief-cta__title {
    font-size: var(--fs-h2);
  }
  .brief-cta__lead {
    margin-block: 1rem 2rem;
    font-size: var(--fs-lead);
    color: var(--slate-70);
    max-width: 50ch;
  }
  .brief-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
</style>
