---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base
  title="Contact"
  description="Contact Project 100 Million. Reach the team by email to engage with the initiative."
  path="/contact"
>
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow">Contact</p>
      <h1 class="contact__title">Get in touch.</h1>
      <p class="contact__lead">
        The most direct way to engage is to <a href="/express-interest">express interest</a>, it
        takes one short reply. For anything else, email us.
      </p>

      <div class="contact__card card">
        <p class="contact__label">Email</p>
        <a class="contact__email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <p class="contact__sla">
          Outreach from and replies to this address come from the Project 100 Million team.
        </p>
      </div>

      <div class="contact__cta">
        <a class="btn btn--primary" href="/express-interest">Express Interest</a>
        <a class="btn btn--ghost" href="/challenge">Read the research</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__title {
    font-size: var(--fs-h1);
    margin-top: 0.9rem;
  }
  .contact__lead {
    margin-top: 1.1rem;
    font-size: var(--fs-lead);
    color: var(--slate-70);
    max-width: 52ch;
  }
  .contact__card {
    margin-top: 2.5rem;
  }
  .contact__label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--teal-deep);
    font-weight: 600;
  }
  .contact__email {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
    font-weight: 700;
    color: var(--slate);
    text-decoration: none;
    border-bottom: 2px solid var(--seafoam);
  }
  .contact__email:hover {
    color: var(--teal-deep);
  }
  .contact__sla {
    margin-top: 1.25rem;
    color: var(--slate-70);
    max-width: 52ch;
  }
  .contact__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }
</style>
