---
import Base from '../layouts/Base.astro';
import StatBig from '../components/StatBig.astro';
import { SITE } from '../data/site';
import { headlineStats } from '../data/stats';

const audiences = [
  {
    title: 'Public sector leaders',
    detail: 'Agencies, workforce boards, community colleges, and economic development organizations aligning to national priorities.',
  },
  {
    title: 'Business decision makers',
    detail: 'CHROs, Heads of L&D, and operations executives building an AI-capable workforce ahead of 2030.',
  },
  {
    title: 'Funders & partners',
    detail: 'Foundations and associations backing rigorous, scalable workforce readiness.',
  },
];
---

<Base
  title={SITE.name}
  description="Project 100 Million is an initiative to make 100 million workers AI-ready by 2030, closing the gap between record AI adoption and a workforce prepared to use it. Building the AI-Ready Workforce."
  path="/"
>
  {/* Hero */}
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy reveal">
        <p class="eyebrow">{SITE.name}</p>
        <h1 class="hero__title">Building the<br />AI-Ready Workforce</h1>
        <p class="hero__mission">
          An initiative to make <strong>100 million workers AI-ready by 2030</strong>, closing
          the widening gap between how fast organizations adopt AI and how prepared their people
          are to use it well.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/express-interest">Express Interest</a>
          <a class="btn btn--ghost" href="/challenge">Read the research</a>
        </div>
      </div>

      <div class="hero__mark reveal" aria-hidden="true">
        <span class="hero__mark-num stat-num stat-num--decor">100M</span>
        <span class="hero__mark-cap">workers · AI-ready · by 2030</span>
      </div>
    </div>
  </section>

  {/* Headline stats */}
  <section class="section section--tint" aria-labelledby="stats-heading">
    <div class="container">
      <h2 id="stats-heading" class="visually-hidden">The readiness gap in three numbers</h2>
      <div class="grid grid--3 stats-row">
        {headlineStats.map((stat) => <StatBig stat={stat} small />)}
      </div>
    </div>
  </section>

  {/* Who this is for */}
  <section class="section" aria-labelledby="who-heading">
    <div class="container">
      <p class="eyebrow">Who this is for</p>
      <h2 id="who-heading" class="who__title">
        Built for the people who decide whether their workforce is ready.
      </h2>
      <div class="grid grid--3 who__grid">
        {
          audiences.map((a) => (
            <div class="who__item">
              <h3 class="who__item-title">{a.title}</h3>
              <p class="who__item-detail">{a.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Closing CTA */}
  <section class="section closing">
    <div class="container container--narrow closing__inner">
      <p class="eyebrow eyebrow--plain">Early interest is now open</p>
      <p class="closing__lead">
        We are gathering early interest from a limited number of organizations. Expressing interest
        is one short reply. No commitment, no obligation, no cost.
      </p>
      <a class="btn btn--primary" href="/express-interest">Express Interest</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(169, 200, 223, 0.22), transparent 55%),
      radial-gradient(90% 80% at 0% 20%, rgba(127, 196, 184, 0.16), transparent 55%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }

  .hero__title {
    font-size: var(--fs-h1);
    margin-top: 1.1rem;
  }

  .hero__mission {
    margin-top: 1.5rem;
    font-size: var(--fs-lead);
    max-width: 48ch;
    color: var(--slate-70);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero__mark {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-self: end;
    text-align: right;
  }

  .hero__mark-num {
    font-size: clamp(4.5rem, 3rem + 11vw, 9rem);
    line-height: 0.9;
  }

  .hero__mark-cap {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--slate-50);
    text-transform: lowercase;
  }

  .stats-row {
    align-items: start;
  }

  .who__title {
    font-size: var(--fs-h2);
    margin-top: 0.9rem;
    max-width: 24ch;
  }

  .who__grid {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
  }

  .who__item-title {
    font-size: var(--fs-h3);
    padding-top: 1.1rem;
    border-top: 2px solid var(--tint-deep);
  }

  .who__item-detail {
    margin-top: 0.6rem;
    color: var(--slate-70);
    font-size: 0.98rem;
  }

  .closing {
    text-align: center;
  }

  .closing__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .closing .eyebrow {
    justify-content: center;
  }

  .closing__lead {
    font-size: var(--fs-lead);
    color: var(--slate);
    margin-block: 1rem 2rem;
    max-width: 44ch;
  }


  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__mark {
      align-items: flex-start;
      justify-self: start;
      text-align: left;
      order: -1;
    }
  }
</style>
