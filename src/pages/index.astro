---
import Brand from '../layouts/Brand.astro';
import { BRAND, PROPERTIES } from '../data/brand';
---

<Brand>
  <header class="top wrap">
    <a href="/" class="mark" aria-label={`${BRAND.name} home`}>
      <span class="mark__dot" aria-hidden="true"></span>Project&nbsp;100M
    </a>
    <nav aria-label="Primary">
      <a href="#sites">Our sites</a>
      <a href="#how">How we work</a>
      <a class="top__cta" href={`mailto:${BRAND.email}`}>Contact</a>
    </nav>
  </header>

  <main>
    <section class="hero wrap" aria-labelledby="hero-title">
      <h1 id="hero-title">
        Useful websites for <span class="hi">everyday decisions.</span>
      </h1>
      <p class="hero__sub">
        We're a small, independent studio. Each site we build answers one everyday question well, and
        people actually use them.
      </p>
    </section>

    <section id="sites" class="sites wrap" aria-label="Our sites">
      <ul class="deck" data-deck>
        {
          PROPERTIES.map((p, i) => (
            <li class="panel" data-active={i === 0 ? 'true' : undefined} style={`--accent:${p.accent}`}>
              <a class="panel__link" href={p.url} target="_blank" rel="noopener">
                <img
                  class="panel__img"
                  src={p.image}
                  alt={p.imageAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
                <span class="panel__shade" aria-hidden="true" />
                <span class="panel__body">
                  <span class="panel__stat">
                    <b>{p.stat.value}</b>
                    <span>{p.stat.label}</span>
                  </span>
                  <span class="panel__q">“{p.question}”</span>
                  <span class="panel__name">{p.name}</span>
                  <span class="panel__line">{p.line}</span>
                  <span class="panel__visit">
                    {p.domain} <span aria-hidden="true">↗</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="how" class="how" aria-labelledby="how-title">
      <div class="wrap how__inner">
        <h2 id="how-title">How we build</h2>
        <ul class="how__list">
          <li>
            <b>Real data</b>
            <span>Places, prices and products checked against live sources, not rewritten from other blogs.</span>
          </li>
          <li>
            <b>Plain English</b>
            <span>Short pages a busy person can act on. No jargon, no 3,000-word intros.</span>
          </li>
          <li>
            <b>One answer</b>
            <span>Each site answers one everyday question, and every page ends in a clear pick or next step.</span>
          </li>
        </ul>
      </div>
    </section>

    <section id="contact" class="contact wrap" aria-labelledby="contact-title">
      <p class="contact__kicker" id="contact-title">Partnerships, sponsorships, press, or a fix for one of our pages</p>
      <a class="contact__mail" href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
      <p class="contact__who">{BRAND.founder}, founder</p>
    </section>
  </main>

  <footer class="foot wrap">
    <span>© {BRAND.year} {BRAND.name}</span>
    <span class="foot__sites">
      {PROPERTIES.map((p) => <a href={p.url} target="_blank" rel="noopener">{p.name}</a>)}
    </span>
  </footer>
</Brand>

<script>
  // Mouse: hovering or focusing a panel opens it. Touch: the deck is a swipe rail with every panel open.
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (deck) {
    const panels = [...deck.querySelectorAll<HTMLElement>('.panel')];
    const open = (p: HTMLElement) => panels.forEach((q) => q.toggleAttribute('data-active', q === p));
    panels.forEach((p) => {
      p.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') open(p);
      });
      p.addEventListener('focusin', () => open(p));
    });
  }
</script>

<style>
  /* ---------- header ---------- */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.4rem;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .mark__dot {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: conic-gradient(#ffb23f 0 33%, #d7b56d 0 66%, #ff6b4a 0);
  }
  .top nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 2rem);
    font-size: 0.95rem;
  }
  .top nav a {
    text-decoration: none;
    color: rgba(243, 239, 230, 0.75);
  }
  .top nav a:hover { color: var(--paper); }
  .top nav a.top__cta {
    color: var(--ink);
    background: var(--paper);
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    align-items: end;
    gap: 2rem 4rem;
    padding-block: clamp(1.5rem, 3.5vw, 3.5rem) clamp(1.5rem, 2.5vw, 2.25rem);
  }
  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.3rem, 0.8rem + 4.6vw, 5.6rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .hi {
    background: linear-gradient(100deg, #ffb23f, #d7b56d 50%, #ff6b4a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__sub {
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    color: rgba(243, 239, 230, 0.72);
    max-width: 34ch;
    padding-bottom: 0.6rem;
  }

  /* ---------- the deck (signature interaction) ---------- */
  .deck {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.75rem;
    height: clamp(420px, 60vh, 660px);
  }
  .panel {
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    border-radius: var(--r);
    overflow: hidden;
    transition: flex-grow 0.7s var(--ease);
    background: var(--ink-2);
  }
  .panel[data-active] { flex-grow: 2.6; }
  .panel__link {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
  }
  .panel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    filter: saturate(0.75) brightness(0.8);
    transition: transform 1.2s var(--ease), filter 0.7s var(--ease);
  }
  .panel[data-active] .panel__img {
    transform: scale(1);
    filter: saturate(1) brightness(0.95);
  }
  .panel__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 19, 16, 0) 22%, rgba(18, 19, 16, 0.66) 50%, rgba(18, 19, 16, 0.96) 100%);
  }
  .panel__body {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(1.2rem, 2vw, 2rem);
    display: grid;
    gap: 0.55rem;
    text-shadow: 0 1px 12px rgba(18, 19, 16, 0.55);
  }
  .panel__stat {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease), transform 0.6s var(--ease);
  }
  .panel__stat b {
    font-family: var(--display);
    font-size: clamp(2.6rem, 2rem + 2vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  .panel__stat span {
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(243, 239, 230, 0.92);
    max-width: 20ch;
    line-height: 1.25;
  }
  .panel__q {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.35rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--accent);
    max-width: 26ch;
  }
  .panel__name {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.8rem);
    letter-spacing: -0.035em;
    line-height: 1;
    transition: font-size 0.6s var(--ease);
  }
  .panel:not([data-active]) .panel__name { font-size: clamp(1.3rem, 0.9rem + 1vw, 1.9rem); }
  .panel__line {
    max-width: 40ch;
    color: rgba(243, 239, 230, 0.85);
    font-size: 1.02rem;
    line-height: 1.4;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .panel__visit {
    justify-self: start;
    margin-top: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.5s var(--ease), transform 0.3s var(--ease);
  }
  .panel__link:hover .panel__visit { transform: translateX(4px); }
  .panel[data-active] :is(.panel__stat, .panel__line, .panel__visit) {
    opacity: 1;
    transform: none;
    transition-delay: 0.18s;
  }

  /* ---------- how ---------- */
  .how {
    margin-top: clamp(4rem, 8vw, 7rem);
    background: var(--paper);
    color: var(--ink);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .how__inner {
    display: grid;
    grid-template-columns: 1fr 2.4fr;
    gap: 2rem 4rem;
  }
  h2 {
    font-family: var(--display);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .how__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .how__list li { display: grid; gap: 0.6rem; align-content: start; }
  .how__list b {
    font-family: var(--display);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    letter-spacing: -0.03em;
    padding-top: 1rem;
    border-top: 3px solid var(--ink);
  }
  .how__list span { color: #4a4a43; font-size: 1rem; }

  /* ---------- contact ---------- */
  .contact {
    padding-block: clamp(4rem, 9vw, 8rem) clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: 1rem;
  }
  .contact__kicker { color: rgba(243, 239, 230, 0.65); font-size: 1.05rem; }
  .contact__mail {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.7rem, 0.4rem + 5.4vw, 6rem);
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 3px no-repeat;
    transition: background-size 0.5s var(--ease), color 0.3s;
    justify-self: start;
    padding-bottom: 0.15em;
  }
  .contact__mail:hover { color: #ffb23f; background-size: 100% 3px; }
  .contact__who { color: rgba(243, 239, 230, 0.65); }

  /* ---------- footer ---------- */
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.6rem 2.2rem;
    border-top: 1px solid var(--line-dark);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .foot__sites { display: flex; gap: 1.4rem; flex-wrap: wrap; }
  .foot a { text-decoration: none; }
  .foot a:hover { color: var(--paper); }

  /* ---------- tablet ---------- */
  @media (max-width: 1023px) {
    .hero { grid-template-columns: 1fr; gap: 1rem; }
    .how__inner { grid-template-columns: 1fr; }
  }

  /* ---------- touch / narrow: the deck becomes a swipe rail, every panel open ---------- */
  @media (max-width: 1023px), (hover: none) {
    .deck {
      height: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * clamp(1.1rem, 4vw, 3rem));
      padding-inline: clamp(1.1rem, 4vw, 3rem);
      scroll-padding-inline: clamp(1.1rem, 4vw, 3rem);
    }
    .deck::-webkit-scrollbar { display: none; }
    .panel {
      flex: 0 0 min(80vw, 420px);
      height: min(400px, 52vh);
      min-height: 340px;
      scroll-snap-align: start;
    }
    .panel[data-active] { flex-grow: 0; }
    .panel__img { transform: none; filter: saturate(1) brightness(0.92); }
    .panel :is(.panel__stat, .panel__line, .panel__visit) { opacity: 1; transform: none; }
    .panel__line { font-size: 0.95rem; }
  }

  @media (max-width: 640px) {
    .top nav a:not(.top__cta) { display: none; }
    .how__list { grid-template-columns: 1fr; gap: 1.5rem; }
    .hero { padding-top: 1.2rem; }
  }
</style>
