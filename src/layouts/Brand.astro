---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import { BRAND, PROPERTIES } from '../data/brand';

export interface Props {
  title?: string;
  description?: string;
}
const { title = BRAND.title, description = BRAND.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, BRAND.domain).href;
const ogImage = new URL('/assets/og-image.png', BRAND.domain).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${BRAND.domain}/#organization`,
      name: BRAND.name,
      url: BRAND.domain,
      description: BRAND.description,
      email: BRAND.email,
      founder: { '@type': 'Person', name: BRAND.founder },
      owns: PROPERTIES.map((p) => ({ '@type': 'WebSite', name: p.name, url: p.url })),
    },
    {
      '@type': 'WebSite',
      '@id': `${BRAND.domain}/#website`,
      url: BRAND.domain,
      name: BRAND.name,
      publisher: { '@id': `${BRAND.domain}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121310" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${BRAND.name}: Wedar, Heirloom Money and Product Review`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {PROPERTIES.map((p) => <link rel="preconnect" href={new URL(p.image).origin} crossorigin />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #121310;
    --ink-2: #1c1d19;
    --paper: #f3efe6;
    --paper-2: #e9e3d6;
    --muted: #8b8a82;
    --line-dark: rgba(243, 239, 230, 0.14);
    --line: rgba(18, 19, 16, 0.12);
    --display: 'Bricolage Grotesque Variable', 'Inter Variable', system-ui, sans-serif;
    --text: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --r: 22px;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --wrap: 1360px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    font-family: var(--text);
    background: var(--ink);
    color: var(--paper);
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }
  img { display: block; max-width: 100%; }
  a { color: inherit; }
  .wrap { width: min(100% - 2 * clamp(1.1rem, 4vw, 3rem), var(--wrap)); margin-inline: auto; }
  :focus-visible { outline: 3px solid #ffb23f; outline-offset: 3px; border-radius: 6px; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
</style>
